# =========================
# DN Apps & Automation
# Environment variables
# =========================

# Admin panel password (REQUIRED in production)
ADMIN_PASSWORD=change-me-strong-password

# Secret used to sign admin session cookies (REQUIRED in production)
ADMIN_SECRET=change-me-long-random-secret

# Upstash Redis (REQUIRED on Vercel so admin edits persist)
# Create a free database at https://console.upstash.com
# Then copy REST URL + REST TOKEN
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx
