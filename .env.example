# =========================
# DN Apps & Automation
# Environment variables
# =========================

# Admin panel password (REQUIRED in production)
ADMIN_PASSWORD=change-me-strong-password

# Secret used to sign admin session cookies (REQUIRED in production)
ADMIN_SECRET=change-me-long-random-secret

# Upstash Redis (REQUIRED on Vercel so admin edits persist)
# Create a free database at https://console.upstash.com
# Then copy REST URL + REST TOKEN
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# Public site URL (optional; used for Open Graph absolute image URLs)
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Contact form email delivery via Resend (REQUIRED for form to send)
# 1) Create account: https://resend.com
# 2) Create API key → paste below
# 3) For production, verify your domain and set CONTACT_FROM_EMAIL
#    e.g. DN Apps <hello@your-domain.com>
# Until domain is verified, Resend only delivers to your Resend account email.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=DN Apps & Automation <onboarding@resend.dev>
# Optional override; by default messages go to admin settings.email
CONTACT_TO_EMAIL=
